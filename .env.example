# Copiază acest fișier ca .env și completează valorile locale.
# Nu introduce parole reale în .env.example și nu comite fișierul .env.

APP_ENV=local
APP_URL=http://localhost:8000

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=eventhub
DB_USER=eventhub
DB_PASSWORD=

# În producție se poate folosi MYSQL_URL oferit de Railway.
# MYSQL_URL=mysql://user:password@host:3306/database

# Configurare SMTP pentru formularul de contact și notificările de rezervare.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=gomesjohn929@gmail.com
SMTP_PASSWORD=
SMTP_ENCRYPTION=tls
