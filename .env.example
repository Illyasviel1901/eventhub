# Copiază acest fișier ca .env și completează valorile locale.
# Nu introduce secrete în acest fișier și nu comite fișierul .env.

APP_URL=http://127.0.0.1:8000

# Conexiune locală MySQL.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=eventhub
DB_USER=eventhub
DB_PASSWORD=

# În Railway folosește MYSQL_URL în locul variabilelor DB_*.
# MYSQL_URL=mysql://user:password@host:3306/database

# Email tranzacțional prin Brevo API HTTPS.
BREVO_API_KEY=
